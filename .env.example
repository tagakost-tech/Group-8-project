# ============================================
# B2B Pharmaceutical Outreach Agent — Config
# ============================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.

# --- AI Company Discovery (Gemini) ---
# The AI features (Copywriter / Analyst / Strategist) can use either provider.
# LLM_PROVIDER=gemini uses GEMINI_API_KEY (google-genai SDK).
# LLM_PROVIDER=groq uses GROQ_API_KEY (free, fast, OpenAI-compatible; no download).
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# Free Groq key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Free heuristic discovery: when Gemini is unavailable/quota'd, the agent
# generates its own European supplement/cosmetic/medical-device search queries
# (no API cost) so autonomous discovery keeps working via DuckDuckGo.
HEURISTIC_DISCOVERY_ENABLED=true

# --- SMTP Configuration ---
# Works with any provider. Company mailboxes on Microsoft 365 (e.g.
# name@yourcompany.com) use smtp.office365.com:587 — the username is the full
# company email address; the domain does NOT need to be @outlook.com.
#   Microsoft 365 (company) -> smtp.office365.com : 587
#   Gmail                   -> smtp.gmail.com : 465
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USERNAME=your-name@yourcompany.com
SMTP_PASSWORD=your-app-password-here

# Optional extra sending mailboxes - each adds its own daily quota, so the
# total/day = the sum of all mailboxes. Fill in what you have, leave rest blank.
# They reuse the SMTP/IMAP servers above; only address/password/name differ.
SENDER_2_EMAIL=
SENDER_2_PASSWORD=
SENDER_2_NAME=
SENDER_3_EMAIL=
SENDER_3_PASSWORD=
SENDER_3_NAME=
SENDER_4_EMAIL=
SENDER_4_PASSWORD=
SENDER_4_NAME=
SENDER_5_EMAIL=
SENDER_5_PASSWORD=
SENDER_5_NAME=

# --- Hot-lead alerts ---
# When a prospect replies with interest, the agent emails this person so a
# human can take over. Blank = off. Comma-separate several addresses.
LEAD_ALERT_EMAIL=

# --- Sender Identity ---
SENDER_NAME=Your Name
COMPANY_NAME=Your Pharmaceutical Company

# --- Scraping ---
SCRAPE_RATE_LIMIT=2.0
MAX_RESULTS_PER_QUERY=20

# --- File Paths ---
DB_PATH=data/agent.db
PDF_PATH=assets/presentation.pdf

# --- Agent Behavior ---
EMAILS_PER_HOUR=30
DELAY_BETWEEN_EMAILS=5.0
# Seconds to wait between loops in continuous mode.
LOOP_DELAY_SECONDS=300
DRY_RUN=false
DEBUG=false

# --- Dashboard ---
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=5000

# --- Target Search Queries (comma-separated) ---
TARGET_QUERIES=pharmaceutical distributor contact email,healthcare provider procurement contact

# --- Email Filtering (comma-separated prefixes to block) ---
# Mailboxes to skip as generic. Deliberately does NOT include info@ or
# sales@: for a small European manufacturer those are routinely the only
# published address and are genuinely monitored. Measured on real target
# sites, blocking them discarded 5 of the 11 addresses the contact-page
# crawl finds. Keep this in step with DEFAULT_BLOCKED_PREFIXES in
# modules/search.py - tests/test_env_template_matches_defaults.py fails
# if the two drift.
BLOCKED_EMAIL_PREFIXES=noreply,no-reply,support,admin,webmaster,abuse,postmaster,mailer-daemon

# ============================================
# Phase 1: Outreach Effectiveness (all optional, off by default)
# ============================================

# --- Lead-quality gate: only email on-target, European companies ---
RELEVANCE_FILTER_ENABLED=false
# Require a target-vertical signal (supplement/cosmetic/medical device/pharma...)
RELEVANCE_REQUIRE_VERTICAL=true
# Override the vertical keyword list if needed (comma-separated).
# RELEVANCE_VERTICALS=supplement,cosmetic,medical device,pharma,...

# --- AI personalization: Gemini writes a tailored opening line per contact ---
# Requires a working GEMINI_API_KEY (see top of file).
AI_PERSONALIZATION_ENABLED=false

# --- Follow-up sequences: automatic multi-touch cadence (Day 3, then Day 7) ---
SEQUENCES_ENABLED=false
DEFAULT_SEQUENCE_NAME=Standard Outreach

# --- Reply & bounce handling via IMAP ---
# When enabled, replies mark contacts 'responded', bounces auto-suppress,
# and follow-up sequences stop. Fill in the IMAP_* values to use it.
# Microsoft 365 (company) -> outlook.office365.com | Gmail -> imap.gmail.com
IMAP_ENABLED=false
IMAP_HOST=outlook.office365.com
IMAP_PORT=993
IMAP_USERNAME=your-name@yourcompany.com
IMAP_PASSWORD=your-app-password-here
IMAP_CHECK_INTERVAL_MINUTES=30

# ============================================
# Phase 2: Intelligence & Deliverability (all optional, off by default)
# ============================================

# --- AI relevance classification (Gemini judges target vs. not) ---
# Runs on leads that pass the heuristic gate. Requires a working GEMINI_API_KEY.
AI_RELEVANCE_ENABLED=false

# --- AI Strategist: LLM chooses the next discovery queries ---
# Dormant until a working GEMINI_API_KEY exists; falls back to free discovery.
AI_STRATEGIST_ENABLED=false

# --- Send-time jitter: random 0..N extra seconds between sends ---
SEND_JITTER_SECONDS=0

# --- A/B testing ---
# Randomly rotates body templates (templates/email_template*.html) and the
# subject variants below; per-variant open rates show at /api/abtest.
AB_TESTING_ENABLED=false
# Comma-separated subject variants (blank = use EMAIL_SUBJECT). {company_name} allowed.
EMAIL_SUBJECTS=

# ============================================
# Required for startup & the dashboard
# ============================================

# --- Unsubscribe link security (REQUIRED - the agent refuses to start
#     while this is blank or left at a published example value) ---
# Any long random string works. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
UNSUBSCRIBE_SECRET=

# Public base URL for unsubscribe links / open tracking. Leave as-is when
# running only on this computer (links then fall back to a safe mailto:).
BASE_URL=http://127.0.0.1:5000

# --- Dashboard login (strongly recommended) ---
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=

# ============================================
# Sending safety rails (defaults are sensible - change knowingly)
# ============================================

# Warm-up: per-mailbox daily cap that grows day by day to protect reputation.
WARMUP_ENABLED=true
WARMUP_START_DAILY=5
WARMUP_INCREMENT=3
WARMUP_MAX_DAILY=100

# Never send more than this to one recipient company (domain) per day.
MAX_PER_DOMAIN_PER_DAY=3

# Business-hours send window (agent timezone below; 0=Mon..6=Sun).
APP_TIMEZONE=Europe/Rome
SEND_WINDOW_ENABLED=true
SEND_WINDOW_START_HOUR=8
SEND_WINDOW_END_HOUR=19
SEND_WINDOW_DAYS=0,1,2,3,4

# Auto-pause when the recent bounce rate threatens sender reputation.
BOUNCE_GUARD_ENABLED=true
MAX_BOUNCE_RATE=0.05
BLACKLIST_CHECK_ENABLED=true

# --- Company profile on first emails ---
# true = attach the PDF at PDF_PATH; false = link to PROFILE_URL instead.
ATTACH_PROFILE=false
PROFILE_URL=

# --- Existing-client protection ---
# Never cold-email a company that is already a client. Point this at the
# client list Excel file (kept in the project folder).
CLIENT_FILTER_ENABLED=true
CLIENT_LIST_PATH=

# --- Known competitors ---
# Never pitch contract manufacturing to a rival. The keyword gate in
# modules/relevance.py infers rivalry from how a company describes itself, and
# a guess always misses some - it missed "CDMO", the industry's own term for
# what SUPPLECO is, until a live run found a company using it. A list of NAMES
# is deterministic and catches the rival whose site says nothing revealing.
# Same file format as the client list (first column, one name per row).
# Leave BLANK to switch the feature off.
COMPETITOR_FILTER_ENABLED=true
COMPETITOR_LIST_PATH=
